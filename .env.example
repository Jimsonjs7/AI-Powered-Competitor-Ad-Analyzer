# Application environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security and auth
API_BEARER_TOKEN=dev-insecure-token-brandmonk
JWT_SECRET=dev-insecure-jwt-secret-replace-in-prod

# Database
DATABASE_URL=sqlite:///./brandmonk.db

# Ad collection providers - Apify (with automatic 3-key fallback pool)
APIFY_API_TOKEN=
APIFY_API_TOKEN_2=
APIFY_API_TOKEN_3=
APIFY_META_ACTOR_ID=jaybird~meta-ad-library-scraper
APIFY_MAPS_ACTOR_ID=compass/crawler-google-places

# Secondary scraping providers (optional)
SCRAPECREATORS_API_KEY=
SERPAPI_API_KEY=
GOOGLE_PLACES_API_KEY=

# Multimodal AI analysis - Gemini (with automatic 3-key fallback pool)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
ANTHROPIC_API_KEY=
IMAGE_GENERATION_API_KEY=

# Storage and limits
MEDIA_STORAGE_DIR=./media_storage
MONTHLY_COST_CAP_USD=10
SCRAPE_TIMEOUT_SECONDS=120
